{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMORA",
  "version": "0.14.6",
  "identifier": "com.photovault.ai",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420/app.html",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LUMORA",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../plugins/examples/": "plugins/examples/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNjc1NjQxMzE2QkEwQTcKUldTbm9Hc3hRVlpuTE9aQ29ERGdXQTJBcEJKV3lYaTArWFpxM3N1ZWVkejg1d3RBd2hqUDZhTkoK",
      "endpoints": [
        "https://github.com/Anurag-error404/lumora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
